---
import Trunk from './Trunk.astro';
import Die from './Die.astro';
import Pads from './Pads.astro';
import IconStar from './IconStar.astro';
import Base from '../layouts/Base.astro';
import { T, MODES, sitePath } from '../lib/i18n.mjs';
import { FAQ } from '../lib/faq.mjs';
import { loadCatalog, abs, REPO, OFFICIAL, TRACKER, REPO_STARS, STAR_GOAL } from '../lib/catalog.mjs';

const { lang } = Astro.props as { lang: 'en' | 'zh' };
const t = T[lang];
const en = lang === 'en';
const cat = loadCatalog();

const canonical = en ? '/' : '/zh/';
const toGoal = Math.max(STAR_GOAL - REPO_STARS, 0);
const lede = t.lede.replace('{total}', String(cat.total)).replace('{blocks}', String(cat.blocks));
const updated = en ? cat.updated : cat.updatedZh;
const description = en
  ? `Explore ${cat.total} DeepSeek Harness (dsh) plugins, tools and skills across ${cat.blocks} categories. Search this community directory and open original project repositories.`
  : `发现 ${cat.total} 个 DeepSeek Harness（dsh）插件、工具与技能，涵盖 ${cat.blocks} 个分类。按用途搜索社区精选项目，查看原始仓库和安装说明。`;
const startingPoints = [
  { id: 'MEM', label: en ? 'Add memory' : '添加记忆' },
  { id: 'TLS', label: en ? 'Find tools' : '扩展工具' },
  { id: 'SKL', label: en ? 'Explore skills' : '发现技能' },
].filter(({ id }) => cat.groups.some((group) => group.id === id));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: 'Awesome DeepSeek Harness',
    alternateName: 'Awesome dsh',
    url: abs('/'),
    description,
    sameAs: REPO,
    inLanguage: [t.htmlLang, en ? 'zh' : 'en'],
    publisher: {
      '@type': 'Organization',
      name: 'awesome-deepseekharness',
      url: 'https://github.com/awesome-deepseekharness',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': abs(canonical),
    url: abs(canonical),
    name: t.title,
    description,
    inLanguage: t.htmlLang,
    dateModified: en ? cat.updated : cat.updatedZh,
    isPartOf: { '@id': abs('/#website') },
    mainEntity: { '@id': abs(`${canonical}#catalog`) },
    hasPart: { '@id': abs(`${canonical}#faq`) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': abs(`${canonical}#catalog`),
    name: en ? 'DeepSeek Harness Plugins' : 'DeepSeek Harness 插件',
    numberOfItems: cat.total,
    itemListElement: cat.groups
      .flatMap((g) => g.items)
      .map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: en ? it.name : it.zhName, url: it.url })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': abs(`${canonical}#faq`),
    inLanguage: t.htmlLang,
    mainEntity: FAQ[lang].map(([question, answer]) => ({
      '@type': 'Question', name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];

const pads = Array.from({ length: STAR_GOAL }, (_, i) => i < REPO_STARS);
const links = [
  ['Discord', 'https://discord.gg/Ycq5dCaS4'],
  [en ? 'Discussions' : '讨论区', 'https://github.com/deepseek-ai/deepseek-harness/discussions'],
  ['dsh-plugin', 'https://github.com/topics/dsh-plugin'],
  [
    'X',
    `https://twitter.com/intent/tweet?text=${encodeURIComponent(en ? 'Awesome DeepSeek Harness — Everything is a Plugin' : 'Awesome DeepSeek Harness — 万物皆可插件')}&url=${encodeURIComponent(REPO)}&hashtags=dsh,deepseek`,
  ],
  [
    'Reddit',
    `https://www.reddit.com/submit?url=${encodeURIComponent(REPO)}&title=${encodeURIComponent('Awesome DeepSeek Harness')}`,
  ],
  ['GitHub', REPO],
];
---

<Base lang={lang} title={t.title} desc={description} keywords={t.keywords} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} slot="head" />

  <div class="die-page">
    <Trunk lang={lang} groups={cat.groups} total={cat.total} />

    <main class="substrate">
      <section class="tb">
        <h1>Awesome DeepSeek Harness</h1>
        <p class="tagline">{t.tagline}</p>
        <p class="lede">{lede}</p>
        <p class="meta">{t.milestone} · {updated}</p>

        <section class="start" aria-labelledby="start-title">
          <h2 id="start-title">{en ? 'What would you add to dsh?' : '你想给 dsh 加什么能力？'}</h2>
          <p>{en ? 'Pick a use case, find a project, then open its repository for setup instructions.' : '选一个用途，找到合适的项目，再打开仓库查看安装说明。'}</p>
          <nav class="start-actions" aria-label={en ? 'Start exploring' : '开始探索'}>
            {startingPoints.map(({ id, label }) => (
              <a class="btn" href={`#blk-${id}`} data-start-block={id}>{label}</a>
            ))}
            <a class="start-all" href="#blocks" data-browse-all>{en ? 'Browse all projects' : '浏览全部项目'}</a>
          </nav>
          <details class="start-help">
            <summary>{en ? 'First visit? How to use this list' : '第一次来？看看怎么用'}</summary>
            <p>{en ? 'Each pad is one project; each block is a category. Choose a category or search by name and description. Select a project to open its repository in a new tab.' : '一个焊盘代表一个项目，一个功能块代表一个分类。可以按分类浏览，也可以搜索名称和说明。点击项目会在新标签页打开它的仓库。'}</p>
            <a href="#what">{en ? 'New to DeepSeek Harness? Start here.' : '还不了解 DeepSeek Harness？从这里开始。'}</a>
          </details>
        </section>

        <div class="star-callout">
          <div>
            <strong>{en ? 'Your next useful plugin is worth saving.' : '先收藏，下次少找一次。'}</strong>
            <p>{en ? 'Keep this toolkit within reach. Your Star also supports the people curating it.' : '把这份工具箱留在 GitHub 收藏里。你的一颗 Star，也是持续整理的动力。'}</p>
          </div>
          <a class="btn star-cta" href={REPO} target="_blank" rel="noopener"><IconStar />{en ? 'Star & save on GitHub' : '去 GitHub 点 Star 收藏'}</a>
          <small>
            {en ? `${REPO_STARS} / ${STAR_GOAL} stars · ${toGoal} to our first milestone. ` : `${REPO_STARS} / ${STAR_GOAL} 颗星 · 距离首个里程碑还差 ${toGoal} 颗。`}
            {en ? 'Open the repository, then click Star in the top-right corner.' : '打开仓库后，点击右上角 Star 即可收藏。'}
          </small>
        </div>

        <div class="acts">
          <a class="btn" href={OFFICIAL} target="_blank" rel="noopener">{t.officialBtn}</a>
          <a class="btn" href={TRACKER} target="_blank" rel="noopener">{t.trackerBtn}</a>
        </div>

        <div class="padmap">
          <div class="grid" role="img" aria-label={`${REPO_STARS} ${t.repoStars} · ${en ? `${toGoal} to go` : `还差 ${toGoal}`}`}>
            {pads.map((on) => <i class={on ? 'on' : ''}></i>)}
          </div>
          <p class="read">
            <b>{REPO_STARS}</b> / {STAR_GOAL} {t.repoStars} · {en ? `${toGoal} to go` : `还差 ${toGoal}`}
          </p>
        </div>
      </section>

      <section class="die-head" id="die">
        <h2>{en ? 'Functional floorplan' : '功能块晶圆图'}</h2>
        <span class="id">{cat.blocks} BLK · {cat.total} PAD</span>
      </section>
      <Die lang={lang} groups={cat.groups} />

      <Pads lang={lang} groups={cat.groups} />

      <section class="plate" id="what">
        <div class="plate-grid">
          <div>
            <h2>{t.whatTitle}</h2>
            <p>{t.whatBody}</p>
            <p class="ko-note"><b>{t.noticeLead}.</b> {t.notice}</p>
          </div>
          <div class="spec">
            <table>
              <thead>
                <tr><th>{t.modeCol}</th><th>{t.modeDescCol}</th></tr>
              </thead>
              <tbody>
                {MODES[lang].map(([m, d]) => (
                  <tr><td>{m}</td><td set:html={d} /></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="plate" id="community">
        <div class="plate-grid">
          <div>
            <h2>{t.communityTitle}</h2>
            <p>{t.communityBody}</p>
            <div class="acts">
              <a class="btn btn-f" href={REPO} target="_blank" rel="noopener"><IconStar />{t.starListBtn}</a>
              <a class="btn" href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">{t.contributingBtn}</a>
            </div>
          </div>
          <div>
            <p>{t.submitLede} <code>dsh-plugin</code> {t.submitTopic} <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>{t.submitCta}</a>.</p>
            <div class="pill-row">
              {links.map(([label, href]) => (
                <a class="pill" href={href} target="_blank" rel="noopener">{label}</a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="plate faq" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">{en ? 'Common questions' : '常见问题'}</h2>
        {FAQ[lang].map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </section>

      <footer class="foot">
        <span class="fmono">{t.footerNote.replace('{date}', updated)}</span>
        <p>
          <a href={REPO} target="_blank" rel="noopener">github.com/awesome-deepseekharness/awesome-deepseek-harness</a>
          {' · '}{t.license}
          {' · '}
          <a href={sitePath(t.otherHref)} lang={t.otherLang} hreflang={t.otherLang}>{t.otherLabel}</a>
        </p>
        <p>
          <a href={sitePath('/llms.txt')}>{en ? 'AI reading guide' : 'AI 阅读索引'}</a>
          {' · '}<a href={sitePath('/catalog.json')}>{en ? 'Catalog JSON' : '目录 JSON'}</a>
          {' · '}<a href={sitePath('/sitemap.xml')}>{en ? 'Sitemap' : '站点地图'}</a>
        </p>
      </footer>
    </main>
  </div>
</Base>

<script>
  type Row = HTMLLIElement;

  const probe = document.getElementById('probe') as HTMLInputElement | null;
  const clearBtn = document.getElementById('probeClear');
  const bus = document.getElementById('bus');
  const resetBtn = document.getElementById('busReset');
  const empty = document.getElementById('empty');
  const results = document.getElementById('results-status');
  const resultReset = document.getElementById('resultsReset');
  const pads = Array.from(document.querySelectorAll<Row>('.padlist .pad'));
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('.block'));
  const nodes = Array.from(document.querySelectorAll<HTMLButtonElement>('.node'));
  const blks = Array.from(document.querySelectorAll<SVGGElement>('.blk .face'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let active = '';

  function light(id: string) {
    const idx = nodes.findIndex((n) => n.dataset.id === id);
    bus?.style.setProperty('--lit', idx < 0 ? '0' : String((idx + 1) / nodes.length));
  }

  function paint(fresh: Row[]) {
    for (const r of fresh.slice(0, 18)) {
      if (reduce) continue;
      r.classList.remove('develop');
      void r.offsetWidth;
      r.style.animationDelay = `${Math.min(fresh.indexOf(r), 18) * 12}ms`;
      r.classList.add('develop');
    }
  }

  function apply() {
    const term = (probe?.value || '').trim().toLowerCase();
    const fresh: Row[] = [];
    let shown = 0;

    for (const row of pads) {
      const inBlock = !active || row.closest('.block')?.dataset.block === active;
      const hit = !term || (row.dataset.hay || '').includes(term);
      const ok = inBlock && hit;
      row.hidden = !ok;
      if (ok) {
        shown++;
        fresh.push(row);
      }
    }

    for (const b of blocks) {
      const n = b.querySelectorAll('.pad:not([hidden])').length;
      b.hidden = n === 0;
      const starTip = b.querySelector<HTMLElement>('.discovery-star');
      if (starTip) starTip.hidden = n === 0 || active !== b.dataset.block;
      const head = b.querySelector('.bhead');
      if (head) {
        const label = head.querySelector('.n');
        if (label) label.innerHTML = `<b>${n}</b> / ${b.querySelectorAll('.pad').length}`;
      }
    }

    for (const f of blks) {
      const id = f.parentElement?.dataset.id || '';
      const on = active === id;
      f.parentElement?.classList.toggle('on', on);
      f.parentElement?.setAttribute('aria-pressed', String(on));
    }
    for (const n of nodes) n.setAttribute('aria-pressed', n.dataset.id === active ? 'true' : 'false');

    if (clearBtn) clearBtn.hidden = term === '';
    if (resetBtn) resetBtn.hidden = !active && term === '';
    if (empty) empty.hidden = shown > 0;
    if (resultReset) resultReset.hidden = !active && term === '';
    if (results) {
      const category = nodes.find((node) => node.dataset.id === active)?.querySelector('i')?.textContent;
      results.textContent = (results.dataset.template || '')
        .replace('{shown}', String(shown)).replace('{total}', String(pads.length))
        + (category ? ` · ${category}` : '');
    }

    paint(fresh);
  }

  function setBlock(id: string) {
    active = active === id ? '' : id;
    light(active);
    apply();
    const section = active ? document.getElementById(`blk-${active}`) : null;
    const target = section && !section.hidden ? section : document.getElementById('blocks');
    target?.focus({ preventScroll: true });
    target?.scrollIntoView({ behavior: reduce ? 'instant' : 'smooth', block: 'start' });
  }

  nodes.forEach((n) => n.addEventListener('click', () => setBlock(n.dataset.id || '')));
  document.querySelectorAll<SVGGElement>('.blk').forEach((g) => {
    g.addEventListener('click', () => setBlock(g.dataset.id || ''));
    g.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setBlock(g.dataset.id || '');
      }
    });
  });
  function resetFilters() {
    active = '';
    if (probe) probe.value = '';
    light('');
    apply();
  }
  resetBtn?.addEventListener('click', () => {
    resetFilters();
    probe?.focus();
  });
  resultReset?.addEventListener('click', () => {
    resetFilters();
    document.getElementById('blocks')?.focus({ preventScroll: true });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-start-block]').forEach((link) => {
    link.addEventListener('click', () => {
      active = link.dataset.startBlock || '';
      if (probe) probe.value = '';
      light(active);
      apply();
      // Keep the anchor's native scrolling and move keyboard focus to its results.
      document.getElementById(`blk-${active}`)?.focus({ preventScroll: true });
    });
  });
  document.querySelectorAll('[data-browse-all]').forEach((link) => {
    link.addEventListener('click', () => {
      resetFilters();
      document.getElementById('blocks')?.focus({ preventScroll: true });
    });
  });
  probe?.addEventListener('input', apply);
  clearBtn?.addEventListener('click', () => {
    if (!probe) return;
    probe.value = '';
    apply();
    probe.focus();
  });
  document.addEventListener('keydown', (e) => {
    const typing = document.activeElement === probe;
    if (e.key === '/' && !typing) {
      e.preventDefault();
      probe?.focus();
    }
    if (e.key === 'Escape' && typing && probe?.value) {
      probe.value = '';
      apply();
    }
  });

  apply();
</script>

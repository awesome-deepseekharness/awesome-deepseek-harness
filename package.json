{
  "name": "awesome-deepseek-harness-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Pages site for awesome-deepseek-harness. Astro builds README.md / README.zh.md into docs/.",
  "scripts": {
    "dev": "astro dev --root site",
    "build": "astro build --root site && node site/scripts/publish.mjs",
    "preview": "astro preview --root site",
    "check": "astro check --root site",
    "models:list": "node scripts/opencode-auto.mjs --list",
    "models:check": "node scripts/opencode-auto.mjs --probe",
    "test:models": "node --test scripts/opencode-free.test.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "@astrojs/sitemap": "^3.7.0"
  }
}
